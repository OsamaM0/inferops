name: "rfdetr_driver_behaviour_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 3, 576, 576 ]
  }
]

output [
  {
    name: "dets"
    data_type: TYPE_FP32
    dims: [ 1, 300, 4 ]
  },
  {
    name: "labels"
    data_type: TYPE_FP32
    dims: [ 1, 300, 7 ]
  }
]

# Two GPU instances allow two concurrent streams to overlap on the GPU
# (one running the kernel, one staging inputs) instead of serialising.
instance_group [
  {
    kind: KIND_GPU
    count: 2
    gpus: [ 0 ]
  }
]

# Build & cache a FP16 TensorRT engine on first load. Subsequent loads reuse
# the cached engine, which gives a 2-4x latency reduction over plain ORT.
optimization {
  execution_accelerators {
    gpu_execution_accelerator: [
      {
        name: "tensorrt"
        parameters { key: "precision_mode"           value: "FP16" }
        parameters { key: "max_workspace_size_bytes" value: "2147483648" }
        parameters { key: "trt_engine_cache_enable"  value: "true" }
        parameters { key: "trt_engine_cache_path"    value: "/workspace/.cache/trt/rfdetr" }
      }
    ]
  }
}

model_warmup [
  {
    name: "zero_input"
    batch_size: 0
    inputs: {
      key: "input"
      value: {
        data_type: TYPE_FP32
        dims: [ 1, 3, 576, 576 ]
        zero_data: true
      }
    }
  }
]

# Easy start: ./run.sh (creates .env if missing, builds, waits for readiness).
# Use ./run.sh --mode cpu --port 8082 for one-launch overrides.
INFEROPS_PROJECT_ROOT=./projects/driver_behaviour
# cpu | cuda | triton (auto is a CPU alias)
INFEROPS_EXECUTION_MODE=cpu
# Optional prebuilt engine image; match its tag to the execution mode.
# Set this, run docker compose pull api prepare, then ./run.sh --no-build.
# INFEROPS_IMAGE=osamam0/inferops-driverbeh:cpu
# Native persistent capture spool (Docker uses its evidence-spool named volume).
INFEROPS_SPOOL_PATH=.run/spool
# Provisional capture policy; tune these with evidence-enabled load tests.
INFEROPS_EVIDENCE_PRE_SECONDS=5
INFEROPS_EVIDENCE_POST_SECONDS=5
INFEROPS_EVIDENCE_SAMPLE_FPS=10
# Extra media history for decisions delayed behind capture; still byte bounded.
INFEROPS_EVIDENCE_PROCESSING_LAG_SECONDS=5
INFEROPS_EVIDENCE_SHUTDOWN_TIMEOUT_SECONDS=30
# Further capacity controls are provisional, not measured hosting minimums.
# INFEROPS_EVIDENCE_MAX_ACTIVE_CAPTURES=64
# INFEROPS_EVIDENCE_WORKERS=2
# INFEROPS_EVIDENCE_PER_SESSION_BYTES=67108864
# INFEROPS_EVIDENCE_GLOBAL_BYTES=268435456
# INFEROPS_EVIDENCE_MAX_SPOOL_BYTES=10737418240
# INFEROPS_EVIDENCE_DISK_RESERVE_BYTES=1073741824
# INFEROPS_EVIDENCE_CAPTURE_TIMEOUT_SECONDS=60
# INFEROPS_EVIDENCE_RETRY_DELAYS=1,5,30
# INFEROPS_MAX_SESSIONS=128
# INFEROPS_SESSION_IDLE_SECONDS=300
# INFEROPS_MODEL_CONCURRENCY=1
# INFEROPS_OPENCV_THREADS=1
# INFEROPS_ORT_THREADS=4
# Keep cuDNN workspace bounded on small GPUs; 1 is a separate VRAM/performance experiment.
INFEROPS_CUDNN_MAX_WORKSPACE=0
# Source registry: number registered is independent from the concurrent limit.
# INFEROPS_MAX_ACTIVE_SOURCES=8
# INFEROPS_SOURCES_PATH=.run/sources
# INFEROPS_SOURCE_RESULT_HISTORY=1000
# INFEROPS_SOURCE_UPLOAD_MAX_BYTES=536870912
# Default compressed RTSP relay, WebRTC/HLS players, recording and playback.
# Select direct only for an explicit embedded/test deployment.
INFEROPS_MEDIA_ROUTER=mediamtx
INFEROPS_MEDIAMTX_RECORD=true
# INFEROPS_MEDIAMTX_RECORD_RETENTION=24h
# INFEROPS_MEDIAMTX_RECORD_SEGMENT=1m
# INFEROPS_MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
# INFEROPS_MEDIAMTX_PLAYBACK_PUBLIC_URL=https://video.example.com/playback
# INFEROPS_MEDIAMTX_PLAYBACK_PORT=9996
# INFEROPS_MEDIAMTX_API_URL=http://127.0.0.1:9997
# INFEROPS_MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
# INFEROPS_MEDIAMTX_API_USER=inferops
# INFEROPS_MEDIAMTX_API_PASSWORD=change-this-local-api-password
# INFEROPS_MEDIAMTX_API_PORT=9997
# INFEROPS_MEDIAMTX_RTSP_PORT=8554
# INFEROPS_MEDIAMTX_WEBRTC_PORT=8889
# INFEROPS_MEDIAMTX_HLS_PORT=8888
# LAN: publish media ports and advertise the server IP for WebRTC.
# INFEROPS_MEDIAMTX_BIND_ADDRESS=0.0.0.0
# INFEROPS_MEDIAMTX_PUBLIC_HOST=192.168.1.10
# HTTPS/proxy: provide browser-facing bases (never camera credentials).
# INFEROPS_MEDIAMTX_WEBRTC_PUBLIC_URL=https://video.example.com/webrtc
# INFEROPS_MEDIAMTX_HLS_PUBLIC_URL=https://video.example.com/hls
# Live player proxy defaults to the Control API host and internal ports 8888/8889.
# INFEROPS_MEDIAMTX_HLS_INTERNAL_URL=http://mediamtx:8888
# INFEROPS_MEDIAMTX_WEBRTC_INTERNAL_URL=http://mediamtx:8889
# Optional CPU-only export worker, installed separately; never installs packages from the dashboard.
# INFEROPS_EXPORT_PYTHON=/absolute/path/.run/export-env/bin/python
# INFEROPS_CHECKPOINT_MAX_BYTES=536870912
# INFEROPS_CAPACITY_REPORTS=.run/capacity
INFEROPS_API_PORT=8080
# If this port is occupied, choose another here or pass ./run.sh --port 8082.
# Add storage,broker,monitoring only when needed. Triton mode requires triton.
COMPOSE_PROFILES=${INFEROPS_EXECUTION_MODE}

# Published host ports. Docker's internal service ports remain fixed.
INFEROPS_MINIO_CONSOLE_PORT=9001
INFEROPS_S3_PORT=9000
INFEROPS_GRAFANA_PORT=3000
INFEROPS_PROMETHEUS_PORT=9090
INFEROPS_PG_PORT=5432
INFEROPS_KAFKA_PORT=19092
INFEROPS_TRITON_HTTP_PORT=8000
INFEROPS_TRITON_GRPC_PORT=8001
INFEROPS_TRITON_METRICS_PORT=8002

# Original MinIO release with the full community admin console.
# Later releases removed console features; see docs/interfaces.md.
INFEROPS_S3_ACCESS_KEY=minio
INFEROPS_S3_SECRET_KEY=minio12345
INFEROPS_S3_BUCKET=inferops
INFEROPS_GRAFANA_USER=admin
INFEROPS_GRAFANA_PASSWORD=admin

# Reverse proxies / remote access: browser-facing service URLs, not Docker names.
# INFEROPS_MINIO_CONSOLE_PUBLIC_URL=https://storage.example.com
# INFEROPS_GRAFANA_PUBLIC_URL=https://metrics.example.com
# INFEROPS_PROMETHEUS_PUBLIC_URL=https://prometheus.example.com
# INFEROPS_S3_PUBLIC_URL=http://localhost:9000
# INFEROPS_KAFKA_HOST=localhost

# Optional engine controls; Docker supplies the internal endpoints by default.
# HF_TOKEN=
# INFEROPS_TRANSPORT_KIND=redpanda
# INFEROPS_OBS_LOG_LEVEL=INFO
# INFEROPS_OBS_LOG_JSON=false

# Server defaults: PostgreSQL, persistent-disk evidence, MediaMTX and in-process delivery.
INFEROPS_DATA_PATH=.run/server
INFEROPS_STORAGE_KIND=filesystem
# Optional MinIO: use scripts/run_mode.py --profiles storage, or select s3 and the storage Compose profile.
INFEROPS_TRANSPORT_KIND=inproc
# Native API default (Docker supplies its internal PostgreSQL endpoint):
# INFEROPS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/inferops
# Optional broker and monitoring: COMPOSE_PROFILES=broker,monitoring
# INFEROPS_TRANSPORT_KIND=redpanda
# INFEROPS_MONITORING_ENABLED=true

# Shared local GPU admission versus bounded remote RPCs (different limits).
INFEROPS_TRITON_CONCURRENCY=64
INFEROPS_TRITON_TIMEOUT_SECONDS=10
INFEROPS_TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.09-py3
# Explicit admission bounds; legacy MODEL_CONCURRENCY/TRITON_CONCURRENCY remain supported.
# INFEROPS_ADMISSION_LOCAL_DEVICE_CAPACITY=1
# INFEROPS_ADMISSION_REMOTE_OUTSTANDING=64
INFEROPS_ADMISSION_MAX_PENDING=1024
INFEROPS_ADMISSION_MAX_QUEUE_AGE_MS=5000
# Optional static workers require PostgreSQL, shared S3 and separate persistent spools.
INFEROPS_ROLE=combined
# INFEROPS_WORKER_MANIFEST=deploy/workers.example.yaml
# INFEROPS_WORKER_TOKEN=<generate-an-internal-control-token>
# INFEROPS_WORKER_ID=a
# INFEROPS_WORKER_WATCHDOG_SECONDS=60
# Prepare first: python scripts/prepare_triton.py --device cuda --output .run/triton/models
# INFEROPS_TRITON_REPOSITORY=./.run/triton/models

# Secrets and essential host overrides ONLY. All normal settings: configs/inferops.yaml.
# Local development credentials; change these for your deployment.
INFEROPS_PG_USER=postgres
INFEROPS_PG_PASSWORD=postgres
INFEROPS_PG_DATABASE=inferops
INFEROPS_S3_ACCESS_KEY=minio
INFEROPS_S3_SECRET_KEY=minio12345
INFEROPS_GRAFANA_USER=admin
INFEROPS_GRAFANA_PASSWORD=admin
INFEROPS_MEDIAMTX_API_USER=inferops
INFEROPS_MEDIAMTX_API_PASSWORD=inferops-local-api
# HF_TOKEN=
# INFEROPS_WORKER_TOKEN=
# External database (optional):
# INFEROPS_DATABASE_URL=postgresql+asyncpg://user:password@database:5432/inferops
# External project / image (optional host overrides):
# INFEROPS_PROJECT_ROOT=/absolute/path/to/project
# INFEROPS_IMAGE=osamam0/inferops-driverbeh:cuda

# Optional server video directory; defaults to this repository’s research folder.
# Mounted read-only at the same absolute path inside API and camera workers.
# INFEROPS_MEDIA_ROOT=/absolute/path/to/videos

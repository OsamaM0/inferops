# InferOps local environment
APP_ENV=dev
INFEROPS_CONFIGS_DIR=configs
INFEROPS_MODEL_REPOSITORY=model_repository

# Transport: use inproc for local single-process development or redpanda for the compose stack.
INFEROPS_TRANSPORT_KIND=inproc
INFEROPS_TRANSPORT_BOOTSTRAP=localhost:19092
INFEROPS_TRANSPORT_CLIENT_ID=inferops
INFEROPS_TRANSPORT_MAX_VALUE_BYTES=65536

INFEROPS_REDIS_URL=redis://localhost:6379/0
INFEROPS_PG_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inferops

INFEROPS_S3_ENDPOINT=http://localhost:9000
INFEROPS_S3_PUBLIC_URL=http://localhost:9000
INFEROPS_S3_REGION=us-east-1
INFEROPS_S3_ACCESS_KEY=minio
INFEROPS_S3_SECRET_KEY=minio12345
INFEROPS_S3_BUCKET=inferops

INFEROPS_TRITON_URL=localhost:8001
INFEROPS_TRITON_HTTP_URL=http://localhost:8000

INFEROPS_API_HOST=0.0.0.0
INFEROPS_API_PORT=8080
INFEROPS_API_CORS_ORIGINS=*

INFEROPS_OBS_LOG_LEVEL=INFO
INFEROPS_OBS_LOG_JSON=false
INFEROPS_OBS_SERVICE_NAME=inferops
INFEROPS_OBS_PROMETHEUS_PORT=9100

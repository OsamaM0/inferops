flowchart LR
    subgraph inbound["Inbound adapters"]
        python["Python Engine facade"]
        http["HTTP / WebSocket / camera"]
        workers["CLI / jobs / broker workers"]
    end
    subgraph center["One modular Python application"]
        app["Application use cases<br/>session / pipeline / incident / evidence / job / delivery"]
        sessions["Generated isolated sessions<br/>capability + owner generation<br/>serialized processing + pinned revision"]
        domain["Pure domain decisions<br/>media clocks / tracking / fusion / incident policy"]
        pool["Engine-owned model pool<br/>bounded shared backends"]
        ports["Application-owned ports<br/>inference / media / project loading<br/>transactions / objects / messaging"]
    end
    subgraph outbound["Outbound adapters"]
        runtime["Existing inference runtimes<br/>existing pre/postprocessing and project plugins"]
        pg["PostgreSQL<br/>required for distributed ownership<br/>sessions / incidents / evidence / inbox / outbox"]
        router["MediaMTX<br/>RTSP relay / WebRTC / HLS<br/>original recording + playback"]
        media["Incremental decoding + encoding<br/>persistent checksummed capture spool"]
        disk["Default FilesystemStorage<br/>persistent disk: snapshot + clip + manifest"]
        minio["Optional S3Storage / MinIO<br/>shared snapshot + clip + artifact manifest"]
        redpanda["Redpanda<br/>at-least-once transport"]
        dev["Explicit embedded memory repository"]
    end
    boot["Explicit bootstrap<br/>construct, start, recover, quiesce, close"]
    python --> app
    http --> app
    workers --> app
    app --> sessions --> domain
    app --> pool --> ports
    app --> ports
    ports -. implemented by .-> runtime
    ports -. implemented by .-> pg
    ports -. implemented by .-> router
    ports -. implemented by .-> media
    ports -. implemented by .-> disk
    ports -. implemented by .-> minio
    ports -. implemented by .-> redpanda
    ports -. implemented by .-> dev
    boot --> app
    boot --> outbound
    monitoring["Prometheus + Grafana<br/>latency, drops, states, spool, delivery lag"]
    http --> monitoring
    bridge["Public API exports<br/>Model / InferenceSession / project extension contracts<br/>previous release artifact for rollback"]
    bridge --> app

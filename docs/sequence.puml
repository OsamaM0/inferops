' ║  11. OBSERVABILITY                                                        ║
' ╚═══════════════════════════════════════════════════════════════════════════╝
== 11 · Observability — metrics, tracing, structured logs ==

group #F5F5FF Observability

  Runner    -> Prom : PIPELINE_RUNS{pipeline, result="ok|error"}.inc()
  Runner    -> Prom : STAGE_LATENCY{pipeline, stage}.observe(seconds)
  Infer     -> Prom : INFER_LATENCY{model}.observe(seconds)\n  INFER_BATCH{model}.observe(batch_size)
  Fuse      -> Prom : FUSION_EVENTS{fusion, rule}.inc()
  AlertStage -> Prom : ALERTS_EMITTED{type, severity}.inc()
  SinkKafkaOut -> Prom : TRANSPORT_PRODUCE{topic, result="ok|error|too_large"}.inc()
  SrcKafka  -> Prom : TRANSPORT_CONSUME{topic, group}.inc()

  Prom -> Prom  : Prometheus scrape :8080/metrics  (30 s)
  Prom -> Dashboard : Grafana dashboards\n  (pipeline runs · model latency · alert rates · transport lag)

  API -> API    : structlog JSON logs (INFEROPS_LOG_JSON=true)\n  init_tracing() → OpenTelemetry → OTel Collector
  note right of API : GET /v1/system/status probes:\n  MinIO :9000/minio/health/live\n  Redpanda admin :19644\n  Triton :8000 HTTP ready\n  PostgreSQL connection

end


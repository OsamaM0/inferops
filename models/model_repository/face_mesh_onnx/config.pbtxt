# Fixed batch-one reference. Prepare a qualified serving repository with scripts/prepare_triton.py.
name: "face_mesh_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 0
version_policy { specific { versions: [1] } }
input [ { name: "input_12" data_type: TYPE_FP32 dims: [1, 3, 256, 256] } ]
output [ { name: "Identity" data_type: TYPE_FP32 dims: [1, 1, 1, 1434] },
{ name: "Identity_1" data_type: TYPE_FP32 dims: [1, 1, 1, 1] },
{ name: "Identity_2" data_type: TYPE_FP32 dims: [1, 1] } ]
instance_group [ { kind: KIND_GPU count: 1 gpus: [0]
  rate_limiter { resources [ { name: "GPU_EXECUTION" count: 1 } ] }
} ]

optimization { execution_accelerators { gpu_execution_accelerator [ { name: "cuda"
  parameters { key: "use_tf32" value: "0" }
  parameters { key: "arena_extend_strategy" value: "kSameAsRequested" }
  parameters { key: "cudnn_conv_use_max_workspace" value: "0" }
} ] } }
parameters { key: "intra_op_thread_count" value: { string_value: "2" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }
model_warmup [ { name: "batch_one" batch_size: 0
  inputs { key: "input_12" value { data_type: TYPE_FP32
    dims: [1, 3, 256, 256] zero_data: true } }
} ]

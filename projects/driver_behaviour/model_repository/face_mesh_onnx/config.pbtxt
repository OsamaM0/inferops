name: "face_mesh_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "input_12"
    data_type: TYPE_FP32
    dims: [ 1, 3, 256, 256 ]
  }
]

output [
  {
    name: "Identity"
    data_type: TYPE_FP32
    dims: [ 1, 1, 1, 1434 ]
  },
  {
    name: "Identity_1"
    data_type: TYPE_FP32
    dims: [ 1, 1, 1, 1 ]
  },
  {
    name: "Identity_2"
    data_type: TYPE_FP32
    dims: [ 1, 1 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [ 0 ]
  }
]

# Identical face crops produce identical landmarks → cache hits are common.
response_cache { enable: true }

optimization {
  execution_accelerators {
    gpu_execution_accelerator: [
      {
        name: "tensorrt"
        parameters { key: "precision_mode"           value: "FP16" }
        parameters { key: "max_workspace_size_bytes" value: "1073741824" }
        parameters { key: "trt_engine_cache_enable"  value: "true" }
        parameters { key: "trt_engine_cache_path"    value: "/cache/trt/face_mesh" }
      }
    ]
  }
}

model_warmup [
  {
    name: "zero_input"
    batch_size: 0
    inputs: {
      key: "input_12"
      value: {
        data_type: TYPE_FP32
        dims: [ 1, 3, 256, 256 ]
        zero_data: true
      }
    }
  }
]

# Fixed batch-one reference. Prepare a qualified serving repository with scripts/prepare_triton.py.
name: "face_detector_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 0
version_policy { specific { versions: [1] } }
input [ { name: "input" data_type: TYPE_FP32 dims: [1, 3, 640, 640] } ]
output [ { name: "cls_8" data_type: TYPE_FP32 dims: [1, 6400, 1] },
{ name: "cls_16" data_type: TYPE_FP32 dims: [1, 1600, 1] },
{ name: "cls_32" data_type: TYPE_FP32 dims: [1, 400, 1] },
{ name: "obj_8" data_type: TYPE_FP32 dims: [1, 6400, 1] },
{ name: "obj_16" data_type: TYPE_FP32 dims: [1, 1600, 1] },
{ name: "obj_32" data_type: TYPE_FP32 dims: [1, 400, 1] },
{ name: "bbox_8" data_type: TYPE_FP32 dims: [1, 6400, 4] },
{ name: "bbox_16" data_type: TYPE_FP32 dims: [1, 1600, 4] },
{ name: "bbox_32" data_type: TYPE_FP32 dims: [1, 400, 4] },
{ name: "kps_8" data_type: TYPE_FP32 dims: [1, 6400, 10] },
{ name: "kps_16" data_type: TYPE_FP32 dims: [1, 1600, 10] },
{ name: "kps_32" data_type: TYPE_FP32 dims: [1, 400, 10] } ]
instance_group [ { kind: KIND_GPU count: 1 gpus: [0]
  rate_limiter { resources [ { name: "GPU_EXECUTION" count: 1 } ] }
} ]

optimization { execution_accelerators { gpu_execution_accelerator [ { name: "cuda"
  parameters { key: "use_tf32" value: "0" }
  parameters { key: "arena_extend_strategy" value: "kSameAsRequested" }
  parameters { key: "cudnn_conv_use_max_workspace" value: "0" }
} ] } }
parameters { key: "intra_op_thread_count" value: { string_value: "2" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }
model_warmup [ { name: "batch_one" batch_size: 0
  inputs { key: "input" value { data_type: TYPE_FP32
    dims: [1, 3, 640, 640] zero_data: true } }
} ]
